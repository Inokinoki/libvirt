<domain type='macosvf'>
  <name>cpu-vendor-model</name>
  <uuid>22223333-4444-5555-6666-777788889999</uuid>
  <memory unit='KiB'>1048576</memory>
  <vcpu placement='static'>2</vcpu>
  <os>
    <type arch='aarch64' machine='macosvf'>hvm</type>
    <kernel>/var/lib/libvirt/boot/vmlinuz</kernel>
    <cmdline>root=/dev/vda1 console=ttyAMA0</cmdline>
  </os>
  <features>
    <acpi/>
  </features>
  <cpu mode='custom' match='exact'>
    <model fallback='forbid'>Cortex-A72</model>
    <vendor id='0x42</vendor>
    <feature policy='require' name='pmu'/>
    <feature policy='require' name='aes'/>
  </cpu>
  <clock offset='utc'/>
  <devices>
    <disk type='file' device='disk'>
      <source file='/var/lib/libvirt/images/disk.img'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
  </devices>
</domain>
