<domain type='macosvf'>
  <name>disk-startup-policy-vm</name>
  <uuid>aaaabbbb-cccc-dddd-eeee-ffffcccc7777</uuid>
  <memory unit='KiB'>1048576</memory>
  <vcpu placement='static'>1</vcpu>
  <os>
    <type arch='aarch64' machine='macosvf'>hvm</type>
    <kernel>/var/lib/libvirt/boot/vmlinuz</kernel>
  </os>
  <features>
    <acpi/>
  </features>
  <clock offset='utc'/>
  <devices>
    <disk type='file' device='disk'>
      <source startupPolicy='optional' file='/var/lib/libvirt/images/disk.img'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
  </devices>
</domain>
