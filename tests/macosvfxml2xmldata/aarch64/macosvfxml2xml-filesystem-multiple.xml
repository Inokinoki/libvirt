<domain type='macosvf'>
  <name>filesystem-multi-vm</name>
  <uuid>aaaa1111-bbbb-2222-cccc-3333dddd4444</uuid>
  <memory unit='KiB'>1048576</memory>
  <vcpu placement='static'>2</vcpu>
  <os>
    <type arch='aarch64' machine='macosvf'>hvm</type>
    <kernel>/var/lib/libvirt/boot/vmlinuz</kernel>
    <cmdline>console=ttyS0 root=/dev/vda1</cmdline>
  </os>
  <features>
    <acpi/>
  </features>
  <clock offset='utc'/>
  <devices>
    <disk type='file' device='disk'>
      <source file='/var/lib/libvirt/images/disk.img'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <filesystem type='mount' accessmode='passthrough'>
      <source dir='/shared/folder1'/>
      <target dir='host-share1'/>
    </filesystem>
    <filesystem type='mount' accessmode='mapped'>
      <source dir='/shared/folder2'/>
      <target dir='host-share2'/>
      <readonly/>
    </filesystem>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
  </devices>
</domain>
