<domain type='macosvf'>
  <name>disk-guest-cleanup</name>
  <uuid>bbbb2222-cccc-3333-dddd-4444eeee5555</uuid>
  <memory unit='KiB'>1048576</memory>
  <vcpu placement='static'>1</vcpu>
  <os>
    <type arch='aarch64' machine='macosvf'>hvm</type>
    <kernel>/var/lib/libvirt/boot/vmlinuz</kernel>
  </os>
  <features>
    <acpi/>
  </features>
  <clock offset='utc'/>
  <devices>
    <disk type='file' device='disk'>
      <driver name='qemu' type='raw'/>
      <source file='/var/lib/libvirt/images/disk.img'>
        <seclabel model='dac' label='foo:bar' relabel='no'/>
      </source>
      <target dev='vda' bus='virtio'/>
    </disk>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
  </devices>
</domain>
