<domain type='macosvf'>
  <name>vm-with-serial</name>
  <uuid>aabbccdd-1122-3344-5566-778899aabbcc</uuid>
  <memory unit='KiB'>524288</memory>
  <vcpu placement='static'>1</vcpu>
  <os>
    <type arch='aarch64' machine='macosvf'>hvm</type>
    <kernel>/var/lib/libvirt/boot/vmlinuz</kernel>
    <cmdline>console=ttyS0</cmdline>
  </os>
  <features>
    <acpi/>
  </features>
  <clock offset='utc'/>
