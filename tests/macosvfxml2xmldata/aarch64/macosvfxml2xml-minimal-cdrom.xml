<domain type='macosvf'>
  <name>minimal-cdrom-vm</name>
  <uuid>88889999-0000-1111-2222-333344445555</uuid>
  <memory unit='KiB'>1048576</memory>
  <vcpu placement='static'>1</vcpu>
  <os>
    <type arch='aarch64' machine='macosvf'>hvm</type>
    <kernel>/var/lib/libvirt/boot/vmlinuz</kernel>
    <boot dev='cdrom'/>
  </os>
  <features>
    <acpi/>
  </features>
  <clock offset='utc'/>
  <devices>
    <disk type='file' device='cdrom'>
      <source file='/var/lib/libvirt/images/install.iso'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
  </devices>
</domain>
